                "presentationValue": [
                    "if (isset($_IPS['OPTIONS'])) {",
                    "   $options = json_decode($_IPS['OPTIONS'], true);",
                    "   $length = count($options);",
                    "   $value = $options[floor($length/2)]['Value'];",
                    "   return $value;",
                    "}",
                    "switch ($_IPS['VARIABLE_TYPE']) {",
                    "  case VARIABLETYPE_BOOLEAN:",
                    "    return false;",
                    "  case VARIABLETYPE_INTEGER:",
                    "    return 1;",
                    "  case VARIABLETYPE_FLOAT:",
                    "    return 1;",
                    "  case VARIABLETYPE_STRING:",
                    "    return '';",
                    "}"
                ],
                "restrictions": {
                    "objectType": [
                        2
                    ],
                    "requestAction": true
                }
            }
