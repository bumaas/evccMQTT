                "format": "{VALUE, duration, format {FORMAT} milliseconds {MILLISECONDS} type {COUNTDOWN_TYPE}}",
                "id": "{08A6AF76-394E-D354-48D5-BFC690488E4E}",
                "presentationParameters": {
                    "COUNTDOWN_TYPE": {
                        "default": 0,
                        "type": 1,
                        "values": [
                            0,
                            1,
                            2
                        ]
                    },
                    "FORMAT": {
                        "default": 1,
                        "type": 1,
                        "values": [
                            0,
                            1,
                            2,
                            3
                        ]
                    },
                    "MILLISECONDS": {
                        "default": false,
                        "type": 0
                    }
                },
                "presentationValue": [
                    "if (!isset($_IPS['COUNTDOWN_TYPE'])) {",
                    "  $_IPS['COUNTDOWN_TYPE'] = 0;",
                    "}",
                    "switch ($_IPS['COUNTDOWN_TYPE']) {",
                    "  case 0:",
                    "    return 7322;",
                    "  case 1:",
                    "    return time() + 7322;",
                    "  case 2:",
                    "    return time() - 7322;",
                    "}"
                ],
                "restrictions": {
                    "objectType": [
                        2
                    ],
                    "requestAction": false,
                    "variableType": [
                        1,
                        2
                    ]
                }
            }
        },
